{
    "name": "tschueller/simplephpcache",
    "type": "library",
    "description": "A very simple PHP caching system which can cache HTML output or variables.",
    "keywords": ["php", "cache", "file-cache", "html-cache"],
    "license": "MIT",
    "authors": [
        {
            "name": "Thorsten Schüller",
            "email": "thorsten@schueller.me"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "classmap": ["class/SimplePhpCache.php"]
    },
    "autoload-dev": {
        "classmap": ["tests/"]
    },
    "scripts": {
        "lint": "php -l class/SimplePhpCache.php",
        "test": "phpunit --testdox",
        "analyse": "phpstan analyse --no-progress",
        "check": ["@lint", "@analyse", "@test"]
    }
}