{
    "name": "tschueller/simplephpcache",
    "type": "library",
    "description": "A very simple PHP caching system which can cache HTML output or variables.",
    "keywords": ["php", "cache", "file-cache", "html-cache"],
    "license": "MIT",
    "authors": [
        {
            "name": "Thorsten Schüller",
            "email": "thorsten@schueller.me"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tschueller\\SimplePhpCache\\": "src/"
        }
    },
    "scripts": {
        "lint": "php -l src/SimplePhpCache.php",
        "test": "phpunit --testdox",
        "analyse": "phpstan analyse --no-progress",
        "check": ["@lint", "@analyse", "@test"],
        "demo": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 127.0.0.1:8000 -t . demo/index.php"
        ]
    }
}
